# Chai AI backend — configuration template.
# Copy this file to `.env` and adjust as needed. Every variable is read from
# the environment and namespaced with the `CHAI_` prefix.
#
# Production safety: `CHAI_ENVIRONMENT=production` refuses to start when the
# configuration relies on unsafe development defaults (debug on, docs enabled,
# permissive CORS/trusted hosts, no database URL, in-memory rate limiter).
# Secrets are supplied ONLY through the environment / this .env file — never
# committed to the repository.

# Runtime environment: development | testing | production
CHAI_ENVIRONMENT=development

# Enable debug behaviour (verbose error messages). MUST stay false in production.
CHAI_DEBUG=true

# Expose interactive docs / OpenAPI: /docs, /redoc, /openapi.json.
# Docs are enabled for development and testing; disable in production.
#CHAI_DOCS_ENABLED=true

# Structured JSON logging on/off. Disable for human-readable console output.
CHAI_JSON_LOGGING=true

# Root logger level: DEBUG | INFO | WARNING | ERROR | CRITICAL
CHAI_LOG_LEVEL=INFO

# Comma-separated CORS allow origins. `*` allows all (development default);
# production MUST NOT contain `*`.
#CHAI_CORS_ORIGINS=https://app.chai.example,https://admin.chai.example

# Comma-separated Host header allowlist. `*` disables host filtering
# (development default); production MUST NOT contain `*`.
#CHAI_TRUSTED_HOSTS=api.chai.example

# Header used to read and echo the per-request id.
CHAI_REQUEST_ID_HEADER=X-Request-ID

# Coarse HTTP-level body-size cap in bytes (multipart uploads are further
# validated against the upload limit below).
#CHAI_MAX_REQUEST_BODY_BYTES=34603008

# Database connection URL (SQLAlchemy format).
# If unset, environment-aware defaults apply:
#   development -> sqlite:///./chai.db
#   testing     -> sqlite://  (in-memory)
#   production  -> fails validation (must be set explicitly)
# Production MUST set this; secrets come from the environment.
#CHAI_DATABASE_URL=postgresql+psycopg://chai:chai@db:5432/chai

# Connection-pool sizing for server-backed databases (PostgreSQL only;
# ignored by SQLite). At least 1.
#CHAI_DATABASE_POOL_SIZE=5
#CHAI_DATABASE_MAX_OVERFLOW=10

# Local filesystem root for the object-storage adapter.
#CHAI_STORAGE_ROOT=./storage

# ---- Upload / image resource-safety limits --------------------------------
# Maximum upload size in bytes (API default 25 MB).
#CHAI_MAX_UPLOAD_SIZE_BYTES=26214400
# Comma-separated allowed image MIME types (magic bytes are authoritative).
#CHAI_ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp
# Reject decompression bombs / pathological dimensions before decoding.
#CHAI_MAX_IMAGE_PIXELS=40000000
#CHAI_MAX_IMAGE_DIMENSION=10000

# ---- Analysis pipeline ------------------------------------------------------
# Maximum number of independent detectors executed concurrently (1 = sequential;
# profile before raising — CPU-bound and memory-bound work may not scale).
#CHAI_PIPELINE_MAX_CONCURRENCY=1
# Wall-clock budget for one analysis pipeline run (seconds). On timeout the
# request answers 504 while the stray pure work finishes in the background.
#CHAI_ANALYSIS_TIMEOUT_SECONDS=60

# ---- Rate limiting -----------------------------------------------------------
# Backend: `none` (default) | `memory` (single-process dev/testing only).
# Production must use a shared backend (e.g. Redis) configured operationally.
#CHAI_RATE_LIMITER=none
#CHAI_RATE_LIMITER_LIMIT=100
#CHAI_RATE_LIMITER_WINDOW_SECONDS=60

# ---- Optional API credentials (future providers, never committed) -------------
# JWT signing secret for access tokens (auth milestone). REQUIRED in production.
#CHAI_JWT_SECRET=replace-with-a-long-random-secret