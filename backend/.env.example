# Chai AI backend — configuration template.
# Copy this file to `.env` and adjust as needed. Every variable is read from
# the environment and namespaced with the `CHAI_` prefix.

# Runtime environment: development | testing | production
CHAI_ENVIRONMENT=development

# Enable debug behaviour (verbose error messages, live docs). Disable in production.
CHAI_DEBUG=true

# Structured JSON logging on/off. Disable for human-readable console output.
CHAI_JSON_LOGGING=true

# Root logger level: DEBUG | INFO | WARNING | ERROR | CRITICAL
CHAI_LOG_LEVEL=INFO

# Comma-separated CORS allow origins. `*` allows all (development default).
CHAI_CORS_ORIGINS=*

# Comma-separated Host header allowlist. `*` disables host filtering.
CHAI_TRUSTED_HOSTS=*

# Header used to read and echo the per-request id.
CHAI_REQUEST_ID_HEADER=X-Request-ID